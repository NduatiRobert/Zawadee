# Normalise all text to LF in the repo (and working tree) so hooks and
# scripts run on Linux CI, and Prettier's LF default is consistent.
* text=auto eol=lf

# Binary assets
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.woff binary
*.woff2 binary

# Generated / vendored: don't diff noisily
pnpm-lock.yaml -diff
